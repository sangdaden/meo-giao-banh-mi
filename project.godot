; Engine configuration file.
; Mở file này bằng Godot 4.3 trở lên.

config_version=5

[application]

config/name="Mèo Giao Bánh Mì"
config/description="Bản chơi thử: mèo Bơ làm bánh mì trong bếp Cô Ba rồi chạy nhảy giao 5 đơn."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Sound="*res://scripts/sound.gd"
NgonNgu="*res://scripts/ngon_ngu.gd"
NhatKy="*res://scripts/nhat_ky.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
textures/vram_compression/import_etc2_astc=true

[shader_globals]

cam_cut_from={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cam_cut_to={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cam_cut_feet={
"type": "float",
"value": 0.0
}
cam_cut={
"type": "float",
"value": 0.0
}

[importer_defaults]

wav={
"compress/mode": 2
}
